# API_KEY: Clé d'authentification pour les services API.
API_KEY="VOTRE_CLE_API"

# APP_URL: URL de l'application (utilisé pour les callbacks OAuth et les endpoints).
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: URL de base du backend Django REST Framework (ex: http://localhost:8000/api/)
VITE_API_BASE_URL="http://localhost:8000/api/"
